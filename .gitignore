*.backup
*.backup-*
*.bak
*.old

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/

# Build/cache
dist/
build/
.cache/

# Temporary files
*.tmp
*.temp

# Project backup directories
backup_*/
