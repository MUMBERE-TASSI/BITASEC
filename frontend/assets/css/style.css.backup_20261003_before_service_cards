/* =========================================================
   LANGUAGE SELECTOR
========================================================= */

.language-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
}

.language-switcher span {
    font-size: 1rem;
}

.language-switcher select {
    width: auto;
    min-width: 125px;
    padding: 8px 30px 8px 10px;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #0f172a;
    color: #e2e8f0;
    font-size: 0.85rem;
    cursor: pointer;
}

.language-switcher select:hover {
    border-color: #2563eb;
}

.language-switcher select:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.15);
}

html[dir="rtl"] {
    direction: rtl;
}

html[dir="rtl"] .nav {
    direction: rtl;
}

html[dir="rtl"] .language-switcher {
    margin-left: 0;
    margin-right: 8px;
}

@media (max-width: 850px) {

    .language-switcher {
        margin-left: 0;
    }

    .language-switcher select {
        min-width: 110px;
        font-size: 0.78rem;
    }
}

/* ============================================================
   RESPONSIVE NAVIGATION
   ============================================================ */

.navbar {
    width: min(1200px, 94%);
    min-height: 72px;
    margin: auto;
    display: flex;
    align-items: center;
    gap: 25px;
}

.navbar .logo {
    color: #fff;
    text-decoration: none;
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: .08em;
    white-space: nowrap;
}

.nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    margin-left: auto;
}

.nav-links a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: .92rem;
    white-space: nowrap;
}

.nav-links a:hover,
.nav-links a.active {
    color: #38bdf8;
}

.nav-links .nav-cta {
    padding: 9px 14px;
    border: 1px solid #2563eb;
    border-radius: 8px;
    color: #fff;
}

#languageSelector {
    width: auto;
    min-width: 105px;
    padding: 8px 10px;
    margin-left: 5px;
    cursor: pointer;
}

.mobile-menu-toggle {
    display: none;
    margin-left: auto;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #0f172a;
    color: #fff;
    padding: 8px 12px;
    font-size: 1.4rem;
    cursor: pointer;
}

/* Mobile navigation */
@media (max-width: 850px) {

    .navbar {
        min-height: 64px;
        flex-wrap: wrap;
        padding: 10px 0;
    }

    .mobile-menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        margin: 0;
        padding: 10px 0 5px;
        order: 4;
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        display: block;
        width: 100%;
        padding: 12px 10px;
        border-bottom: 1px solid #1e293b;
    }

    .nav-links .nav-cta {
        margin-top: 8px;
        text-align: center;
    }

    #languageSelector {
        margin-left: 0;
        min-width: 95px;
    }

}

/* =========================================================
   SERVICE BUTTON / TECH CARDS
========================================================= */

.tech-card {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 92px;
    margin: 10px 0;
    padding: 18px 20px;
    text-align: left;
    text-decoration: none;
    color: #e5e7eb;
    border: 1px solid #334155;
    border-radius: 14px;
    background: linear-gradient(135deg, #111827, #0f172a);
    cursor: pointer;
    transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease,
        background .25s ease;
}

.tech-card:hover {
    transform: translateY(-4px);
    border-color: #2563eb;
    background: linear-gradient(135deg, #172554, #111827);
    box-shadow: 0 14px 35px rgba(0, 0, 0, .28);
}

.tech-card:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 3px;
}

.tech-icon {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(37, 99, 235, .15);
    border: 1px solid rgba(37, 99, 235, .35);
    font-size: 1.6rem;
}

.tech-card-content {
    flex: 1;
    min-width: 0;
}

.tech-card-title {
    display: block;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 3px;
}

.tech-card-description {
    display: block;
    color: #94a3b8;
    font-size: .9rem;
    line-height: 1.45;
}

.tech-card-arrow {
    flex: 0 0 auto;
    color: #38bdf8;
    font-size: 1.4rem;
    font-weight: 700;
    transition: transform .25s ease;
}

.tech-card:hover .tech-card-arrow {
    transform: translateX(6px);
}

@media (max-width: 600px) {
    .tech-card {
        min-height: 82px;
        padding: 15px;
    }

    .tech-icon {
        flex-basis: 44px;
        width: 44px;
        height: 44px;
        font-size: 1.35rem;
    }

    .tech-card-title {
        font-size: .98rem;
    }

    .tech-card-description {
        font-size: .82rem;
    }
}

/* =========================================================
   PROFESSIONAL BITASEC SERVICE CARDS
========================================================= */

.tech-card {
    position: relative;
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 18px;
    width: 100%;
    min-height: 112px;
    margin: 14px 0;
    padding: 20px 22px;
    overflow: hidden;

    text-align: left;
    text-decoration: none;
    color: #e5e7eb;

    border: 1px solid #243247;
    border-radius: 16px;

    background:
        linear-gradient(135deg, rgba(37,99,235,.10), transparent 45%),
        #111827;

    box-shadow:
        0 8px 25px rgba(0,0,0,.18);

    cursor: pointer;

    transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease,
        background .25s ease;
}

.tech-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: #2563eb;
    transform: scaleY(.35);
    transform-origin: center;
    transition: transform .25s ease;
}

.tech-card:hover {
    transform: translateY(-5px);
    border-color: #2563eb;

    background:
        linear-gradient(135deg, rgba(37,99,235,.18), transparent 55%),
        #111827;

    box-shadow:
        0 18px 40px rgba(0,0,0,.30),
        0 0 25px rgba(37,99,235,.08);
}

.tech-card:hover::before {
    transform: scaleY(1);
}

.tech-card:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 4px;
}

.tech-icon {
    width: 58px;
    height: 58px;

    display: grid;
    place-items: center;

    border-radius: 15px;

    background:
        linear-gradient(135deg, rgba(37,99,235,.25), rgba(15,23,42,.8));

    border: 1px solid rgba(56,189,248,.22);

    font-size: 1.7rem;

    box-shadow:
        inset 0 0 20px rgba(37,99,235,.08);

    transition:
        transform .25s ease,
        box-shadow .25s ease;
}

.tech-card:hover .tech-icon {
    transform: scale(1.08);
    box-shadow:
        0 0 25px rgba(37,99,235,.22);
}

.tech-card-content {
    min-width: 0;
}

.tech-card-title {
    display: block;

    margin-bottom: 5px;

    color: #fff;

    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: .01em;
}

.tech-card-description {
    display: block;

    max-width: 600px;

    color: #94a3b8;

    font-size: .9rem;
    line-height: 1.5;
}

.tech-card-arrow {
    display: flex;
    align-items: center;
    gap: 8px;

    white-space: nowrap;

    color: #38bdf8;

    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.tech-card-arrow::before {
    content: "Explore";
}

.tech-card-arrow {
    font-size: 1.35rem;
}

.tech-card:hover .tech-card-arrow {
    transform: translateX(5px);
}

@media (max-width: 600px) {

    .tech-card {
        grid-template-columns: 50px 1fr auto;
        gap: 13px;
        min-height: 95px;
        padding: 16px;
    }

    .tech-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        font-size: 1.35rem;
    }

    .tech-card-title {
        font-size: .98rem;
    }

    .tech-card-description {
        font-size: .82rem;
    }

    .tech-card-arrow::before {
        content: "";
    }
}

