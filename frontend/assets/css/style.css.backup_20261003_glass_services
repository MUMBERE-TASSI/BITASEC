    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: fit-content;

    margin-top: 22px;
    padding: 10px 17px;

    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 8px;

    background: rgba(37, 99, 235, 0.12);

    color: #38bdf8;

    font-size: 0.78rem;
    font-weight: 800;

    letter-spacing: 0.04em;
    text-transform: uppercase;

    transition:
        background 0.25s ease,
        border-color 0.25s ease,
        transform 0.25s ease;
}

/* Button text */
.hero-panel .tech-card-arrow::before {
    content: "Explore Service";
    margin-right: 10px;
}

/* Arrow */
.hero-panel .tech-card-arrow {
    font-size: 1rem;
}

/* Button hover */
.hero-panel .tech-card:hover .tech-card-arrow {
    transform: translateX(4px);

    border-color: #38bdf8;

    background: #2563eb;

    color: #ffffff;
}

/* =========================================================
   SERVICE GRID
   ========================================================= */

.hero-panel {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 18px;
}

/* Orbit spans full width */
.hero-panel .tech-orbit {
    grid-column: 1 / -1;
}

/* Electrical card spans full width */
.hero-panel .tech-card[data-service="electrical"] {
    grid-column: 1 / -1;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 900px) {

    .hero-panel {
        grid-template-columns: 1fr;
    }

    .hero-panel .tech-orbit {
        grid-column: auto;
    }

    .hero-panel .tech-card[data-service="electrical"] {
        grid-column: auto;
    }

}

@media (max-width: 600px) {

    .hero-panel .tech-card {
        min-height: 210px;

        padding: 22px;

        border-radius: 16px;
    }

    .hero-panel .tech-icon {
        width: 52px;
        height: 52px;

        margin-bottom: 18px;

        font-size: 1.4rem;
    }

    .hero-panel .tech-card-title {
        font-size: 1.02rem;
    }

    .hero-panel .tech-card-description {
        font-size: 0.84rem;
    }

    .hero-panel .tech-card-arrow {
        padding: 9px 14px;

        font-size: 0.72rem;
    }

}

/* Keyboard accessibility */
.hero-panel .tech-card:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 4px;
}


/* =========================================================
   BITASEC SERVICE ACTION BUTTON
   ========================================================= */

.hero-panel .tech-card-button {
    position: relative;
    z-index: 5;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    width: fit-content;

    margin-top: 24px;
    padding: 11px 20px;

    border: 1px solid #2563eb;
    border-radius: 8px;

    background: #2563eb;

    color: #ffffff;

    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 800;

    line-height: 1;

    letter-spacing: 0.04em;
    text-transform: uppercase;

    box-shadow:
        0 6px 18px rgba(37, 99, 235, 0.22);

    transition:
        background 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
}

.hero-panel .tech-card-button-arrow {
    font-size: 1rem;
    transition: transform 0.25s ease;
}

.hero-panel .tech-card:hover .tech-card-button {
    background: #1d4ed8;

    border-color: #38bdf8;

    box-shadow:
        0 8px 25px rgba(37, 99, 235, 0.35);
}

.hero-panel .tech-card:hover .tech-card-button-arrow {
    transform: translateX(5px);
}

/* Keep the service button clearly visible */
.hero-panel .tech-card-button span {
    pointer-events: none;
}

/* Mobile */
@media (max-width: 600px) {

    .hero-panel .tech-card-button {
        padding: 10px 16px;
        font-size: 0.72rem;
    }

}


/* =========================================================
   FINAL OVERRIDE — VISIBLE SERVICE BUTTONS
   ========================================================= */

.hero-panel a.tech-card .tech-card-button {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;

    width: max-content !important;
    min-width: 155px !important;

    margin-top: 22px !important;
    padding: 12px 18px !important;

    border: 1px solid #2563eb !important;
    border-radius: 8px !important;

    background: #2563eb !important;

    color: #ffffff !important;

    font-size: 0.78rem !important;
    font-weight: 800 !important;

    line-height: 1 !important;
    text-align: center !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;

    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.25) !important;

    opacity: 1 !important;
    visibility: visible !important;
}

.hero-panel a.tech-card .tech-card-button::before {
    content: none !important;
}

.hero-panel a.tech-card .tech-card-button-arrow {
    display: inline-block !important;

    color: #ffffff !important;

    font-size: 1rem !important;

    opacity: 1 !important;
    visibility: visible !important;
}

.hero-panel a.tech-card:hover .tech-card-button {
    background: #1d4ed8 !important;
    border-color: #38bdf8 !important;

    transform: translateY(-2px) !important;

    box-shadow:
        0 10px 25px rgba(37, 99, 235, 0.38) !important;
}

.hero-panel a.tech-card:hover .tech-card-button-arrow {
    transform: translateX(5px);
}

/* Make the whole service card remain clickable */
.hero-panel a.tech-card {
    cursor: pointer !important;
}


/* =========================================================
   BITASEC SERVICE SHOWCASE HEADING
   ========================================================= */

.hero-panel .services-showcase-heading {
    grid-column: 1 / -1;

    position: relative;
    z-index: 2;

    margin: 10px 0 4px;

    text-align: center;
}

.services-showcase-label {
    display: inline-block;

    margin-bottom: 10px;

    color: #38bdf8;

    font-size: 0.72rem;
    font-weight: 800;

    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.services-showcase-heading h2 {
    margin: 0 auto 12px;

    max-width: 720px;

    color: #ffffff;

    font-size: clamp(1.6rem, 3vw, 2.35rem);
    font-weight: 800;

    line-height: 1.15;

    letter-spacing: -0.025em;
}

.services-showcase-heading p {
    max-width: 650px;

    margin: 0 auto;

    color: #94a3b8;

    font-size: 0.92rem;

    line-height: 1.65;
