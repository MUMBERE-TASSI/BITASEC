/* Keep orbit underneath the heading */
.hero-panel .tech-orbit {
    grid-column: 1 / -1;
    margin-top: 8px;
}

/* Mobile */
@media (max-width: 900px) {

    .hero-panel .services-showcase-heading {
        grid-column: 1;
    }

    .hero-panel .tech-orbit {
        grid-column: 1;
    }

}

@media (max-width: 600px) {

    .hero-panel .services-showcase-heading {
        margin-top: 5px;
        margin-bottom: 8px;
    }

    .services-showcase-label {
        font-size: 0.64rem;
        letter-spacing: 0.12em;
    }

    .services-showcase-heading h2 {
        font-size: 1.5rem;
    }

    .services-showcase-heading p {
        font-size: 0.84rem;
    }

}

