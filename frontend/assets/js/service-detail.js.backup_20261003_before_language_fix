    function start() {

        render(getService());

        /*
         * The existing main.js handles the language selector.
         * When the language changes, it dispatches the change event.
         * We listen for it and rebuild the dynamic service page.
         */
        const selector = document.getElementById("languageSelect");

        if (selector) {

            selector.value = getLanguage();

            selector.addEventListener("change", function () {

                localStorage.setItem(
                    "bitasec_language",
                    this.value
                );

                render(getService());

            });

        }

    }


    if (document.readyState === "loading") {

        document.addEventListener(
            "DOMContentLoaded",
            start
        );

    } else {

        start();

    }

