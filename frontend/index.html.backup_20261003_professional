    document.addEventListener("DOMContentLoaded", () => {
        const selector = document.getElementById("languageSelector");
        if (!selector) return;

        const applyTranslations = (lang) => {
            const dictionary = translations[lang] || translations['en'];
            document.querySelectorAll("[data-i18n]").forEach(element => {
                const translationKey = element.getAttribute("data-i18n");
                if (dictionary[translationKey]) {
                    element.textContent = dictionary[translationKey];
                }
            });
            localStorage.setItem("bitasec_current_lang", lang);
        };

        const initialLang = localStorage.getItem("bitasec_current_lang") || "en";
        selector.value = initialLang;
        applyTranslations(initialLang);

        selector.addEventListener("change", (event) => {
            applyTranslations(event.target.value);
        });
    });
</script>
